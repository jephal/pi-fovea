{
  "name": "pi-fovea",
  "version": "0.10.0",
  "description": "Token-budgeted repo mapping for agent sessions: foveated heat diffusion over a cross-language code graph, with progressive disclosure.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "author": "monotykamary",
  "packageManager": "pnpm@11.20.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/pi-fovea.git"
  },
  "homepage": "https://github.com/monotykamary/pi-fovea#readme",
  "bugs": "https://github.com/monotykamary/pi-fovea/issues",
  "keywords": [
    "pi-package",
    "pi-extension",
    "repo-map",
    "code-graph",
    "heat-diffusion",
    "progressive-disclosure",
    "context-engineering",
    "agents"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/monotykamary/pi-fovea/main/media/cover.svg"
  },
  "exports": {
    "./ops": "./src/core/ops.ts"
  },
  "files": [
    "src",
    "cli.ts",
    "dist",
    "skills",
    "media",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "fovea": "dist/cli.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "tsx scripts/bench.ts",
    "build:cli": "tsx scripts/build-cli.ts",
    "prepack": "pnpm run build:cli",
    "fovea": "tsx cli.ts",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@earendil-works/pi-tui": "0.84.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typebox": "^1.3.10",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true }
  }
}
