{
  "name": "pi-fovea",
  "version": "0.4.0",
  "description": "Token-budgeted repo mapping for agent sessions: foveated heat diffusion over a cross-language code graph, with progressive disclosure.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "author": "monotykamary",
  "packageManager": "pnpm@11.20.0",
  "repository": { "type": "git", "url": "git+https://github.com/monotykamary/pi-fovea.git" },
  "homepage": "https://github.com/monotykamary/pi-fovea#readme",
  "bugs": "https://github.com/monotykamary/pi-fovea/issues",
  "keywords": ["pi-package", "pi-extension", "repo-map", "code-graph", "heat-diffusion", "progressive-disclosure", "context-engineering", "agents"],
  "pi": { "extensions": ["./src/index.ts"], "skills": ["./skills"], "image": "https://raw.githubusercontent.com/monotykamary/pi-fovea/main/media/cover.svg" },
  "exports": { "./ops": "./src/core/ops.ts" },
  "files": ["src", "cli.ts", "skills", "media", "README.md", "LICENSE"],
  "publishConfig": { "access": "public" },
  "bin": { "fovea": "cli.ts" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "tsx scripts/bench.ts",
    "fovea": "tsx cli.ts",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "typebox": "^1.0.76"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.6",
    "@earendil-works/pi-tui": ">=0.80.6"
  }
}
